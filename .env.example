# Browser Agent Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# OPTION 1: Standard Anthropic API
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# =============================================================================
# OPTION 2: Enterprise Bedrock Endpoint
# =============================================================================
# ANTHROPIC_BEDROCK_BASE_URL=https://your-endpoint.com/v1
# ANTHROPIC_AUTH_TOKEN=your-auth-token
# ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-20250514

# =============================================================================
# Note: The agent will automatically detect which authentication to use.
# If ANTHROPIC_BEDROCK_BASE_URL and ANTHROPIC_AUTH_TOKEN are set, it uses
# the enterprise endpoint. Otherwise, it uses ANTHROPIC_API_KEY.
# =============================================================================
