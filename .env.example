# Browser Agent Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# PROVIDER 1: Anthropic (Claude) - Default
# =============================================================================
# Standard API
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Or Enterprise Bedrock Endpoint
# ANTHROPIC_BEDROCK_BASE_URL=https://your-endpoint.com/v1
# ANTHROPIC_AUTH_TOKEN=your-auth-token
# ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-20250514

# =============================================================================
# PROVIDER 2: OpenAI (GPT-4)
# =============================================================================
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o                          # Default: gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1    # Or Azure/custom endpoint

# =============================================================================
# PROVIDER 3: Ollama (Local Models)
# =============================================================================
# OLLAMA_BASE_URL=http://localhost:11434       # Default Ollama URL
# OLLAMA_MODEL=llava                           # Use llava for vision support

# =============================================================================
# Provider Auto-Detection
# =============================================================================
# The agent automatically detects which provider to use based on which
# environment variables are set:
# 1. If ANTHROPIC_API_KEY or ANTHROPIC_BEDROCK_BASE_URL → uses Anthropic
# 2. If OPENAI_API_KEY → uses OpenAI
# 3. If OLLAMA_MODEL or OLLAMA_BASE_URL → uses Ollama
#
# You can also explicitly specify: --provider anthropic|openai|ollama
# =============================================================================
